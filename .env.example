# ============================================
# NFS-e Backend — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ============================================

NFSE_VERSION=v1
NFSE_HOMOLOGACAO=true
NFSE_MOCK=true

# Dados do prestador (substitua pelos seus)
INSCRICAO_MUNICIPAL=000000
CNPJ_PRESTADOR=00000000000000
RAZAO_SOCIAL="Sua Razão Social Ltda"

# Certificado A1 (opcional — pode enviar pela interface)
# CERT_PATH=./certs/seu-certificado.pfx
# CERT_PASSWORD=sua-senha-do-certificado

PORT=3001
SSL_PORT=3443
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem
FRONTEND_URL=http://localhost:3000

# ============================================
# 🔴 OBRIGATÓRIO — Gerar valores únicos!
# ============================================
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nfse_db?schema=public"
JWT_SECRET="coloque-aqui-um-segredo-de-32-caracteres-ou-mais"
CERT_ENCRYPTION_KEY="coloque-aqui-uma-chave-de-32-caracteres"
JWT_EXPIRES_IN="24h"

ENABLE_MULTI_TENANT=true

# Usuário admin padrão (criado pelo seed)
DEFAULT_USER_EMAIL="admin@empresa.com"
DEFAULT_USER_PASSWORD="Admin@123456"

# Usuário master (painel de administração)
MASTER_EMAIL="master@admin.com"
MASTER_PASSWORD="Master@123456"

# Dias para alerta de expiração do certificado
CERT_ALERT_DAYS=30

# Email verification (opcional — sem isso, o link de verificação é logado no console)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_TEMPLATE_ID=tmpl_xxxxxxxxxxxx
# EMAIL_FROM=onboarding@resend.dev